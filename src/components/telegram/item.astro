---
import '../../assets/widget-frame.css'
import 'prismjs/themes/prism.css'
import dayjs from '../../telegram/dayjs'

const locale = 'zh-cn'
const timezone = 'Asia/Shanghai'

locale && dayjs.locale(locale)

const { SITE_URL } = Astro.locals
const { post, isItem } = Astro.props

const channel = 'kongdf'
const COMMENTS = true

const datetime = dayjs(post.datetime).tz(timezone)
const timeago = datetime.isBefore(dayjs().subtract(1, 'w'))
  ? datetime.format('HH:mm · ll · ddd')
  : datetime.fromNow()
---

<div class="item"  >
 
  {post.content.length > 0 && <div class={`text-box content`} set:html={post.content} />}
  


  <!-- 这个评论真丑，先不放开 -->
  <!-- {
    COMMENTS  && (
      <div class="comments">
        <script
          is:inline
          async
          src="https://telegram.org/js/telegram-widget.js"
          data-telegram-discussion={`${channel}/${post.id}`}
          data-comments-limit="50"
          data-colorful="1"
          data-color="454545"
        />
      </div>
    )
  } -->
  <div style="margin-top: 10px;">
    <time class="text-50 text-sm font-medium" datetime={post.datetime} title={timeago}>{timeago}</time> 

  </div>

</div>
