---
import WidgetLayout from "./WidgetLayout.astro";

const COLLAPSED_HEIGHT = "7.5rem";

interface Props {
  class?: string;
  style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---

<WidgetLayout
  name="展墙"
  id="ShowMe"
  isCollapsed={false}
  collapsedHeight={COLLAPSED_HEIGHT}
  class={className}
  style={style}
>
  <div class="flex gap-2 flex-wrap">
    <div class="px-4">
      <div class="text-left text-neutral-400 mb-2.5 transition">
        <p>微信号：kdf092</p>

        <p>公众号：我做个艺术家</p>
        <p>小程序：我做个艺术家</p>
        <p>
          工具箱：<a
            href="https://box.kongdf.com/"
            class="text-[var(--primary)]"
            target="_blank"
            rel="noopener noreferrer">box.kongdf.com</a
          >
        </p>
      </div>
    </div>
  </div>
</WidgetLayout>
